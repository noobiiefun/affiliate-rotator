# Contoh penanda "Mode Offline" untuk build.
#
# JANGAN edit file ini langsung untuk build manual — pakai:
#   npm run dist:offline:win   (atau :mac / :linux / :portable)
# yang otomatis membuat & menghapus .env.production.local di root project.
#
# Kalau mau membuat manual: copy isi baris di bawah ini ke file baru
# bernama ".env.production.local" di root project (sejajar package.json),
# lalu jalankan `npm run build && electron-builder --win` seperti biasa.

NEXT_PUBLIC_OFFLINE_MODE=true
