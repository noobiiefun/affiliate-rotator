# ============================================================
# AFFILIATE ROTATOR - Environment Variables
# Copy file ini menjadi .env.local dan isi dengan nilai Anda
# ============================================================

# ---------------------------
# Supabase (WAJIB)
# Dapatkan dari: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# ---------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---------------------------
# App Config
# ---------------------------
# URL publik website Anda (untuk generate QR code yang benar)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Salt untuk hashing IP address (bisa random string apa saja)
IP_HASH_SALT=ganti-dengan-random-string-rahasia

# ---------------------------
# (Opsional) Untuk production di Vercel
# Vercel mengisi VERCEL_URL otomatis, tidak perlu diisi manual
# ---------------------------
# VERCEL_URL=affiliate-rotator.vercel.app
